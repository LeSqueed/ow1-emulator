{
  "name": "ow1-emulator",
  "version": "1.0.0",
  "description": "Overwatch 1 Emulator - Backend Services for Constants Management",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/server/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "dev:watch": "concurrently \"npm run dev\" \"npm run ts:watch\"",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "clean": "rm -rf dist build",
    "build:all": "npm run clean && npm run build && npm run lint && npm run test",
    "prettier": "prettier --write \"src/**/*.{ts,js}\"",
    "prettier:check": "prettier --check \"src/**/*.{ts,js}\"",
    "generate": "ts-node src/scripts/generate-constants.ts",
    "db:migrate": "ts-node src/scripts/migrate-db.ts",
    "db:seed": "ts-node src/scripts/seed-db.ts",
    "db:all": "npm run db:migrate && npm run db:seed"
  },
  "keywords": [
    "overwatch",
    "emulator",
    "database",
    "constants",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "cors": "^4.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "typescript": "^5.3.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/winston": "^2.14.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
